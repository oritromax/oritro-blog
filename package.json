{
  "name": "astro-exp",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "astro": "astro",
    "test": "npm run test:unit && npm run test:build",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:build": "npm run build && vitest run tests/build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:build && PW_SKIP_BUILD=1 playwright test",
    "test:coverage": "vitest run tests/unit --coverage",
    "typecheck": "astro check && tsc -p tests/tsconfig.json --noEmit",
    "report": "playwright show-report"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.5.1",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@tailwindcss/vite": "^4.0.12",
    "astro": "^5.13.7",
    "remark-directive": "^4.0.0",
    "tailwindcss": "^4.0.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^3.2.7",
    "gray-matter": "^4.0.3",
    "linkedom": "^0.18.13",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vitest": "^3.2.7"
  }
}
